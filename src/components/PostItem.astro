---
// One build note in a list: title, one-line description, date.
import type { CollectionEntry } from 'astro:content';
import { isoDate, longDate } from '../lib/site';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Heading level: h2 on the writing index, h3 under the home page's h2. */
  level?: 'h2' | 'h3';
}

const { post, level = 'h3' } = Astro.props;
const Heading = level;
---

<article class="post-item">
  <div>
    <Heading class="post-item__title"><a class="link" href={`/writing/${post.id}/`}>{post.data.title}</a></Heading>
    <p class="post-item__desc">{post.data.description}</p>
  </div>
  <time class="post-item__date" datetime={isoDate(post.data.date)}>{longDate(post.data.date)}</time>
</article>
