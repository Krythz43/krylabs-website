---
// A horizontal row of phone screenshots at their native aspect ratio.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Shot {
  img: ImageMetadata;
  alt: string;
}

interface Props {
  shots: Shot[];
  variant?: 'hero' | 'page';
  /** How many images load eagerly (the ones above the fold). */
  eager?: number;
}

const { shots, variant = 'page', eager = 0 } = Astro.props;
---

<div class={`strip strip--${variant}`}>
  {shots.map((s, i) => (
    <figure class="strip__shot" style={`--i:${i}`}>
      <Image
        src={s.img}
        alt={s.alt}
        widths={[240, 480]}
        sizes="(max-width: 760px) 200px, 240px"
        loading={i < eager ? 'eager' : 'lazy'}
        fetchpriority={i < eager ? 'high' : 'auto'}
        decoding="async"
      />
    </figure>
  ))}
</div>
