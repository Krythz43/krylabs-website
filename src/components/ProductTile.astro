---
// A web product: a screenshot of the live site, then who it is for. Links out.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const d = product.data;
const host = new URL(d.url).host;
---

<article class="tile">
  <a class="tile__shot" href={d.url} target="_blank" rel="noopener" aria-label={`Open ${d.name}`}>
    <Image src={d.shot} alt={`${d.name} website`} width={1040} widths={[520, 1040]} sizes="(max-width: 760px) 100vw, 520px" loading="lazy" decoding="async" />
  </a>
  <div class="tile__body">
    <Image class="tile__icon" src={d.icon} alt="" width={80} height={80} loading="lazy" />
    <div>
      <h3 class="tile__name">
        <a class="link" href={d.url} target="_blank" rel="noopener">{d.name}</a>
      </h3>
      <p class="tile__tag">{d.tagline}. {host}</p>
      <p class="tile__desc">{d.summary}</p>
    </div>
  </div>
</article>
