---
import Base from '../layouts/Base.astro';
import Founder from '../components/Founder.astro';
import Defs from '../components/Defs.astro';
import Socials from '../components/Socials.astro';
import { site } from '../lib/site';
import { person, organization } from '../lib/jsonld';

const principles = [
  { t: 'Built end to end', d: 'Every product is designed, developed and shipped by one person, from the first sketch to the store listing. Nothing is handed off.' },
  { t: 'Small and sharp', d: 'Each app does one thing and does it well. Scope is the main design tool.' },
  { t: 'Solve a real itch', d: 'ReelMark exists because saved reels vanish. BlockBud exists because generic block screens do not work. The apps start from a problem the founder actually had.' },
  { t: 'Private by default', d: 'BlockBud and One keep everything on the device. BubbleNest stores no location and no email. Collecting less is a feature.' },
];

const description = `${site.name} is an independent app and product studio founded by ${site.founder.name} in Bengaluru, India.`;
---

<Base title={`About ${site.name}`} description={description} ogImage="/og/about.png" jsonLd={[person(), organization()]}>
  <section class="page">
    <div class="container">
      <p class="kicker hero__kicker">About</p>
      <h1 class="display">An independent studio that ships.</h1>
      <p class="lead page__lead">
        {site.name} is a one-person studio in Bengaluru. It builds iPhone apps and web products end to end,
        and publishes them under its own name.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Founder wide>
        <p>
          Krithick is an iOS engineer. He studied at IIT Kharagpur, then worked on payments at PhonePe and quick
          commerce at Blinkit before starting {site.name} to build his own products.
        </p>
        <p>
          The studio is where that experience turns into apps: ReelMark, BubbleNest, BlockBud and CocoTree on the
          App Store, and GymWhiteBoard, LeadOven, Galentini and Comet on the web. He designs, builds, tests and
          publishes each one himself, and answers the support email.
        </p>
        <p style="margin-top:22px"><Socials /></p>
      </Founder>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <h2 class="display">How the studio works</h2>
      </div>
      <Defs items={principles} />
    </div>
  </section>
</Base>
