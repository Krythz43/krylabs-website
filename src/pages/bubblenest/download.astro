---
// /bubblenest/download — one link to hand out anywhere; it lands each visitor in the
// right store. Deliberately NOT wrapped in Base.astro: this page has to be usable in the
// first frame, so it cannot wait on the layout's Lenis + GSAP bundle.
//
// The page ALWAYS renders its chooser first and only then navigates. The obvious design —
// location.replace() from an inline head script — was live briefly and broke: starting a
// navigation mid-parse means the body never renders, so Safari showed a white flash and
// Instagram's in-app webview, which blocks automatic cross-origin hops, showed a white
// page forever with no way out. Rendering first makes a blocked redirect a no-op: the
// visitor is already looking at two working buttons.
//
// Known in-app browsers therefore skip the automatic hop entirely and get a one-tap
// button instead — a tap carries the user gesture those webviews require.
//
// Desktop and anything unrecognised get the plain chooser: a wrong guess sends someone to
// a store they cannot install from, which is worse than one extra tap.
const IOS_URL = 'https://apps.apple.com/app/bubblenest-friend-finding-app/id6743532224';
const ANDROID_URL = 'https://play.google.com/store/apps/details?id=com.krylabs.bubblenest';
// Non-http scheme, used only inside in-app webviews — see the click handler below.
const IOS_SCHEME_URL = 'itms-apps://apps.apple.com/app/id6743532224';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Download BubbleNest</title>
    <meta name="description" content="Get BubbleNest on iPhone or Android — one link, the right store." />
    <!-- A redirect stub has nothing to index; keep /bubblenest as the canonical page. -->
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://krylabs.com/bubblenest" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="theme-color" content="#fbfbf9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Krylabs" />
    <meta property="og:title" content="Download BubbleNest" />
    <meta property="og:description" content="Make friends through what you're into right now. Free on iPhone and Android." />
    <meta property="og:url" content="https://krylabs.com/bubblenest/download" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Webfonts are a progressive nicety; font-display:swap keeps them off the critical
         path so the buttons are readable (in fallback faces) in the first paint. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <!-- is:global is load-bearing. Scoped styles compile `* { padding: 0 }` into
         `[data-astro-cid-…] { padding: 0 }` — an attribute selector that outranks plain
         element selectors, so it silently beat `body { padding: 32px 24px }` and
         `h1 { margin: … }`. That is why the cards ran edge-to-edge on a phone. This page
         owns its whole document, so there is nothing to scope against anyway. -->
    <style is:global>
      :root {
        --bg: #fbfbf9;
        --ink: #17160f;
        --ink-3: #5a584e;
        --muted: #76746a;
        --line: #e6e4dc;
        --card: #ffffff;
        --accent: #bf4d2e;
        --accent-soft: #f6ebe4;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-font-smoothing: antialiased; }
      body {
        min-height: 100vh;
        /* Grid, not flex: as a flex item the card resolved its width against the wrong
           box and spilled over the side padding, so the rows ran edge-to-edge on a
           phone. A grid area respects the padding. */
        display: grid;
        place-items: center;
        padding: 32px 24px;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.6;
        font-size: 17px;
        letter-spacing: -0.011em;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }

      .wrap { width: 100%; max-width: 460px; text-align: center; }
      .eyebrow {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
      }
      h1 {
        margin: 14px 0 12px;
        font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif;
        font-weight: 400;
        font-size: clamp(2.2rem, 7vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
      }
      h1 em { font-style: italic; color: var(--accent); }
      .lead { color: var(--ink-3); margin-bottom: 30px; }

      /* Column order matters: JS promotes the visitor's own store to the top. */
      .stores { display: flex; flex-direction: column; gap: 12px; }
      .store {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 20px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        text-align: left;
        transition: border-color 0.25s ease, transform 0.25s ease;
      }
      .store:hover { border-color: var(--ink); transform: translateY(-2px); }
      .store svg { flex: 0 0 auto; }
      .store b { display: block; font-size: 1.02rem; font-weight: 600; }
      .store span { display: block; font-size: 0.85rem; color: var(--muted); }
      .store .go { margin-left: auto; color: var(--muted); }

      /* The store we detected — pulled to the top and given the accent treatment. */
      .store.is-primary {
        order: -1;
        border-color: var(--accent);
        background: var(--accent-soft);
      }
      .store.is-primary .go { color: var(--accent); }

      .status {
        margin-top: 26px;
        font-size: 0.86rem;
        color: var(--muted);
        min-height: 1.6em; /* reserve the line so swapping the copy never shifts layout */
      }
      .status a { border-bottom: 1px solid var(--line); }
      .status a:hover { border-color: var(--ink); }
    </style>
  </head>
  <body>
    <main class="wrap">
      <p class="eyebrow">BubbleNest</p>
      <h1>Get the <em>app</em>.</h1>
      <p class="lead">Make friends through what you're into right now. Free on iPhone and Android.</p>

      <div class="stores">
        <a class="store" id="store-ios" href={IOS_URL} rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.9-3.5.9s-1.8-.8-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.6 2.3 2.8 2.2 1.1 0 1.6-.7 2.9-.7s1.7.7 2.9.7 2-1.1 2.7-2.1c.9-1.2 1.2-2.4 1.2-2.4s-2.4-.9-2.4-3.7zM14.2 5.9c.6-.8 1-1.9.9-3-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-.9 2.9 1 0 2.1-.5 2.7-1.3z"/>
          </svg>
          <div>
            <b>App Store</b>
            <span>iPhone &amp; iPad</span>
          </div>
          <span class="go" aria-hidden="true">↗</span>
        </a>

        <a class="store" id="store-android" href={ANDROID_URL} rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.6 2.2a1 1 0 0 0-.5.9v17.8a1 1 0 0 0 .5.9l9.4-9.8L3.6 2.2zm11 8.1L5.4 1.6l10 5.7-1.8 3zM5.4 22.4l9.2-8.7 1.8 3-10 5.7zm11.9-6.7-2-3.3 2-3.3 3.6 2c.7.4.7 1.4 0 1.8l-3.6 2.8z"/>
          </svg>
          <div>
            <b>Google Play</b>
            <span>Android</span>
          </div>
          <span class="go" aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="status" id="status">Pick your store, or <a href="/bubblenest">learn more about BubbleNest</a></p>
    </main>

    <script is:inline define:vars={{ IOS_URL, ANDROID_URL, IOS_SCHEME_URL }}>
      (function () {
        var ua = navigator.userAgent || '';
        var params = new URLSearchParams(location.search);

        // ?platform=ios|android forces a destination (per-platform QR codes, support
        // links); ?stay=1 suppresses the hop so the page itself can be reviewed.
        var forced = (params.get('platform') || '').toLowerCase();
        var stay = params.has('stay');

        // Windows Phone's UA contained "Android" for compatibility — exclude it.
        var isAndroid = /android/i.test(ua) && !/windows phone/i.test(ua);
        // iPadOS 13+ reports itself as a Mac; the touch-point count is what separates them.
        var isIOS =
          /iphone|ipod|ipad/i.test(ua) ||
          (/macintosh/i.test(ua) && typeof navigator.maxTouchPoints === 'number' && navigator.maxTouchPoints > 1);

        var wantsAndroid = forced === 'android' || (!forced && isAndroid);
        var wantsIOS = forced === 'ios' || (!forced && !isAndroid && isIOS);
        if (!wantsAndroid && !wantsIOS) return; // desktop / unknown → plain chooser

        // Social apps' embedded webviews. They routinely refuse a script-initiated hop to
        // a store URL but honour the identical link when the user taps it, so they get the
        // button treatment instead of a redirect that would silently do nothing.
        var inApp = /Instagram|FBAN|FBAV|FB_IAB|Snapchat|TikTok|musical_ly|Bytedance|Twitter|LinkedInApp|Pinterest|Line\/|WhatsApp|MicroMessenger|KAKAOTALK|GSA\//i.test(ua);

        var target = wantsAndroid ? ANDROID_URL : IOS_URL;
        var storeName = wantsAndroid ? 'Google Play' : 'the App Store';

        // Campaign attribution rides along when present, in each store's own dialect.
        var ref = params.get('ref');
        if (ref) {
          var sep = target.indexOf('?') === -1 ? '?' : '&';
          target += sep + (wantsAndroid ? 'referrer' : 'ct') + '=' + encodeURIComponent(ref);
        }

        // Promote the visitor's store: first in the column, accent-styled, and carrying
        // any ?ref attribution the automatic hop would have added.
        var primary = document.getElementById(wantsAndroid ? 'store-android' : 'store-ios');
        var status = document.getElementById('status');
        if (primary) {
          primary.className += ' is-primary';
          primary.href = target;
        }

        if (stay) return;

        if (inApp) {
          if (status) status.textContent = 'Tap above to open ' + storeName + '.';
          // Carry ?ref onto the scheme URL too, so in-app taps stay attributed.
          if (wantsIOS && primary) {
            enableInAppAppStoreTap(
              primary,
              status,
              IOS_SCHEME_URL + (ref ? '?ct=' + encodeURIComponent(ref) : '')
            );
          }
          return;
        }

        if (status) status.textContent = 'Opening ' + storeName + '…';

        // Two frames, then hop: the first callback runs before the first paint, the second
        // after it. Navigating only once something is on screen is what keeps a blocked or
        // slow redirect from leaving a blank page.
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            // replace(), not assign() — Back should return to wherever the link was
            // tapped, not to this page, which would immediately bounce forward again.
            location.replace(target);

            // Still here a beat later? The hop was refused. Say so instead of leaving
            // "Opening…" on screen forever above two buttons that do work.
            setTimeout(function () {
              if (status) status.textContent = 'Tap above to open ' + storeName + '.';
            }, 2500);
          });
        });

        // Instagram's iOS webview swallows a tap on https://apps.apple.com entirely — no
        // navigation, no error, nothing (Google Play works in the same webview because it
        // is an ordinary page; the Apple URL is a universal link the host app never hands
        // to the system). The itms-apps:// scheme is a non-http URL, which these webviews
        // do forward to iOS, and firing it from inside the tap preserves the user gesture
        // they require. Everything escalates from there, so no tap can dead-end.
        function enableInAppAppStoreTap(link, statusEl, schemeUrl) {
          link.setAttribute('href', schemeUrl);

          // If the App Store opens, this document is backgrounded — that is how we tell
          // "it worked" from "the webview ate it" and avoid escalating over a success.
          var left = false;
          function departed() { return left || document.hidden; }
          window.addEventListener('pagehide', function () { left = true; });
          window.addEventListener('blur', function () { left = true; });
          document.addEventListener('visibilitychange', function () {
            if (document.hidden) left = true;
          });

          link.addEventListener('click', function () {
            // No preventDefault: the itms-apps:// navigation is the primary attempt.
            setTimeout(function () {
              if (departed()) return;
              // Scheme refused too — try Apple's web page, which at worst renders the
              // listing inside the webview. `target` carries any ?ref attribution.
              location.href = target;
              setTimeout(function () {
                if (departed()) return;
                if (statusEl) {
                  statusEl.textContent =
                    'This in-app browser is blocking the App Store. Open this page in Safari to continue.';
                }
              }, 1400);
            }, 1000);
          });
        }
      })();
    </script>
  </body>
</html>
