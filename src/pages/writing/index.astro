---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, longDate } from '../../lib/site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const description = `Build notes from ${site.name}: what shipped, what broke, and what it took to fix.`;
---

<Base title={`Writing | ${site.name}`} description={description} ogImage="/og/writing.png">
  <section class="page">
    <div class="container">
      <p class="kicker hero__kicker">Writing</p>
      <h1 class="display">Build notes.</h1>
      <p class="lead page__lead">What shipped, what broke, and what it took to fix. Written as it happened.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts">
        {posts.map((p) => (
          <article class="post-item">
            <div>
              <h2 class="post-item__title"><a class="link" href={`/writing/${p.id}`}>{p.data.title}</a></h2>
              <p class="post-item__desc">{p.data.description}</p>
            </div>
            <time class="post-item__date" datetime={p.data.date.toISOString().slice(0, 10)}>
              {longDate(p.data.date.toISOString().slice(0, 10))}
            </time>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
