---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, isoDate, longDate } from '../../lib/site';
import { portraitUrl } from '../../lib/portrait';
import { blogPosting, organization, person } from '../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const published = isoDate(post.data.date);
const updated = post.data.updated ? isoDate(post.data.updated) : undefined;
// The contents list in the margin: the post's sections, worth showing from two up.
const sections = headings.filter((h) => h.depth === 2);
---

<Base
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  ogImage={`/og/writing-${post.id}.png`}
  ogType="article"
  published={published}
  jsonLd={[blogPosting(post), person(await portraitUrl()), organization()]}
>
  <div class="notes notes--post">
    <aside class="notes__side">
      <div class="notes__side-inner">
        <a class="notes__back" href="/writing/"><span aria-hidden="true">←</span> Index</a>
        {sections.length > 1 && (
          <nav class="notes__toc" aria-label="On this page">
            <ul>
              {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </nav>
        )}
      </div>
    </aside>
    <article class="notes__main">
      <header class="notes__head notes-in">
        <h1 class="notes__title">{post.data.title}</h1>
        <p class="notes__meta">
          {site.founder.name}, <time datetime={published}>{longDate(published)}</time>
          {updated && <>. Updated <time datetime={updated}>{longDate(updated)}</time></>}
        </p>
      </header>
      <div class="notes__body notes-in">
        <Content />
      </div>
    </article>
  </div>
  {sections.length > 1 && (
    <script is:inline>
      // Marks the section being read in the margin's contents list: the last heading
      // above the top third of the window.
      (function () {
        var links = [].slice.call(document.querySelectorAll('.notes__toc a'));
        var heads = links.map(function (a) { return document.getElementById(decodeURIComponent(a.hash.slice(1))); });
        var update = function () {
          var cur = -1;
          heads.forEach(function (h, i) { if (h && h.getBoundingClientRect().top < innerHeight * 0.3) cur = i; });
          links.forEach(function (a, i) { if (i === cur) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
        };
        addEventListener('scroll', function () { requestAnimationFrame(update); }, { passive: true });
        update();
      })();
    </script>
  )}
</Base>
