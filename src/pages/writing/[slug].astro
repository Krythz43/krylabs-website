---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, longDate } from '../../lib/site';
import { blogPosting } from '../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const iso = post.data.date.toISOString().slice(0, 10);
---

<Base title={`${post.data.title} | ${site.name}`} description={post.data.description} ogImage={`/og/writing-${post.id}.png`} jsonLd={blogPosting(post)}>
  <article class="page article">
    <div class="container">
      <p class="kicker hero__kicker"><a class="link link--quiet" href="/writing">Build notes</a></p>
      <h1 class="display">{post.data.title}</h1>
      <p class="article__meta">
        {site.founder.name}, <time datetime={iso}>{longDate(iso)}</time>
      </p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <div class="section--tight"></div>
</Base>
