---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
---

<Base title={`Page not found | ${site.name}`} noindex>
  <section class="page page--end">
    <div class="container">
      <p class="kicker hero__kicker">Error 404</p>
      <h1 class="display">This page wandered off.</h1>
      <p class="lead page__lead">The link is broken or the page has moved. The apps are still where they were.</p>
      <div class="page__actions">
        <a href="/" class="btn">Back to {site.name}</a>
        <a href="/#apps" class="btn btn--ghost">See the apps</a>
      </div>
    </div>
  </section>
</Base>
