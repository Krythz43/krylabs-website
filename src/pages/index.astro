---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Strip from '../components/Strip.astro';
import AppRow from '../components/AppRow.astro';
import ProductTile from '../components/ProductTile.astro';
import Founder from '../components/Founder.astro';
import Socials from '../components/Socials.astro';
import { listing, screens } from '../lib/appstore';
import { site, longDate } from '../lib/site';
import { organization, person, website } from '../lib/jsonld';

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

// The numbers in the lead are computed, so they cannot go stale.
const onAppStore = apps.filter((a) => listing(a.id)).length;
const onPlay = apps.filter((a) => a.data.platforms.includes('Android')).length;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const num = (n: number) => words[n] ?? String(n);

// Hero strip: one screenshot from each featured app, then a second from each, so the
// first screenful shows every app rather than six views of one.
const featured = apps.filter((a) => a.data.featured);
const heroShots = [0, 1].flatMap((i) =>
  featured.flatMap((a) => {
    const img = screens(a.id)[i];
    return img ? [{ img, alt: `${a.data.name} screenshot ${i + 1}` }] : [];
  }),
);
---

<Base jsonLd={[organization(), person(), website()]}>
  <section class="hero">
    <div class="container">
      <p class="kicker hero__kicker">{site.name} is a one-person app studio in Bengaluru.</p>
      <h1 class="display">{site.tagline}</h1>
      <p class="lead hero__lead">
        {site.founder.name} designs, builds and ships every app here, end to end: {num(onAppStore)} on the App Store,
        {num(onPlay)} on Google Play and {num(products.length)} on the web.
      </p>
      <div class="hero__actions">
        <a href="#apps" class="btn">See the apps</a>
        <a href="/writing" class="btn btn--ghost">Read the build notes</a>
      </div>
      <p class="hero__creds">Previously at PhonePe and Blinkit. IIT Kharagpur.</p>
      <Strip shots={heroShots} variant="hero" eager={4} />
    </div>
  </section>

  <section class="section" id="apps">
    <div class="container">
      <div class="section__head">
        <h2 class="display">Apps</h2>
        <p class="kicker">Designed, built and published in-house. Screenshots are from the store listings.</p>
      </div>
      <div class="rows">
        {apps.map((app) => <AppRow app={app} />)}
      </div>
    </div>
  </section>

  <section class="section section--soft" id="web">
    <div class="container">
      <div class="section__head">
        <h2 class="display">On the web</h2>
        <p class="kicker">Products with their own sites.</p>
      </div>
      <div class="tiles">
        {products.map((p) => <ProductTile product={p} />)}
      </div>
    </div>
  </section>

  <section class="section" id="founder">
    <div class="container">
      <Founder>
        <p>
          Krithick is an iOS engineer who worked on payments at PhonePe and quick commerce at Blinkit before
          starting {site.name} to build his own things. Every app on this page is his work, from the first sketch to
          the store listing.
        </p>
        <p><a class="link" href="/about">More about Krithick and how the studio works</a></p>
      </Founder>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section--soft" id="writing">
      <div class="container">
        <div class="section__head">
          <h2 class="display">Writing</h2>
          <p class="kicker">Build notes: what shipped, what broke, what it took.</p>
        </div>
        <div class="posts">
          {posts.map((p) => (
            <article class="post-item">
              <div>
                <h3 class="post-item__title"><a class="link" href={`/writing/${p.id}`}>{p.data.title}</a></h3>
                <p class="post-item__desc">{p.data.description}</p>
              </div>
              <time class="post-item__date" datetime={p.data.date.toISOString().slice(0, 10)}>
                {longDate(p.data.date.toISOString().slice(0, 10))}
              </time>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="contact">
    <div class="container">
      <div class="section__head">
        <h2 class="display">Say hello</h2>
        <p class="kicker">Questions, feedback or press. Replies usually take a day or two.</p>
      </div>
      <div class="contact">
        <div>
          <p class="contact__label">Email</p>
          <a class="contact__big link" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div>
          <p class="contact__label">Krithick elsewhere</p>
          <Socials />
        </div>
      </div>
    </div>
  </section>
</Base>
