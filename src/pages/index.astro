---
import Base from '../layouts/Base.astro';
import Strip from '../components/Strip.astro';
import AppRow from '../components/AppRow.astro';
import Defs from '../components/Defs.astro';
import Founder from '../components/Founder.astro';
import PostItem from '../components/PostItem.astro';
import Socials from '../components/Socials.astro';
import Stack from '../components/Stack.astro';
import Faq from '../components/Faq.astro';
import { getApps, getPosts, onAppStore, listingFor, shotsFor, HOME_IDS } from '../lib/apps';
import { site, credentials, workHistory, whatsapp, phoneDisplay } from '../lib/site';
import { portraitUrl } from '../lib/portrait';
import { organization, person, website, faqPage } from '../lib/jsonld';

const apps = await getApps();
const allPosts = await getPosts();
const posts = allPosts.slice(0, 3);
// The long-form proof of the founder's work, linked from the track record.
const blinkit = allPosts.find((p) => p.id === 'ios-at-blinkit');

// The number in the lead is computed from the same facts the rows show, so it cannot drift.
const storeCount = apps.filter(onAppStore).length;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const num = (n: number) => words[n] ?? String(n);
const cap = (w: string) => w[0].toUpperCase() + w.slice(1);

// Hero strip: one screenshot from each featured app, then a second from each, so the
// first screenful shows every app rather than six views of one.
const perApp = apps.filter((a) => a.data.featured).map((a) => shotsFor(a, 2));
const heroShots = [0, 1].flatMap((i) => perApp.flatMap((shots) => shots.slice(i, i + 1)));

// Apps that are still being worked on: a store update within the past year, as of this build.
const yearAgo = new Date(Date.now() - 365 * 864e5).toISOString().slice(0, 10);
const shipping = apps.flatMap((a) => {
  const l = listingFor(a);
  return l && l.updated >= yearAgo ? [{ name: a.data.name, version: l.version }] : [];
});
const shippingLine = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(
  shipping.map((s, i) => (i === 0 ? `${s.name} is on version ${s.version}` : `${s.name} on ${s.version}`)),
);

// The track record, arranged as the checks a careful buyer makes before hiring an iOS
// developer: can I install something they shipped, do they keep it alive, have they worked
// at scale, do releases and crashes have an owner, can I read their code. Each row answers
// one with something the reader can go and verify.
const track = [
  {
    t: 'Live apps you can install',
    d: `${cap(num(storeCount))} apps on the App Store, each designed, built and published end to end. Install one before you call.`,
    href: `#${HOME_IDS.apps}`,
  },
  ...(shipping.length > 0 ? [{ t: 'Still shipping after launch', d: `${shippingLine}, each updated in the past year.` }] : []),
  {
    t: 'Work at scale',
    d: "Built Blinkit's order-tracking Live Activity on the lock screen and in the Dynamic Island as the only iOS developer on it, plus an in-house analytics pipeline in Swift and Objective-C. Before that, payments at PhonePe, one of the most heavily used apps in India.",
    href: blinkit ? `/writing/${blinkit.id}/` : undefined,
  },
  {
    t: 'Releases and crashes with an owner',
    d: 'Fastlane release automation that made Blinkit\'s builds 41% faster, and crash alerts that reached the team in Slack. BubbleNest goes to the App Store through a Fastlane pipeline today.',
  },
  { t: 'Code you can read', d: 'The source of this website is public, with its full commit history.', href: `${site.founder.github}/krylabs-website` },
];

// Fixed-scope work: a small first project with a set length, for an app that already exists.
// `price` is printed when it is set (e.g. 'From ₹1,50,000'); until the founder fixes a figure
// the line says how the price is agreed instead of inventing one.
const offers: { t: string; length: string; price?: string; d: string }[] = [
  {
    t: 'A Live Activity for your app',
    length: 'About three weeks',
    d: "For an app already on the App Store. The lock screen and Dynamic Island design, the SwiftUI views, the push updates worked out with your backend team, and the release. It is the work Krithick did on Blinkit's order tracking, done for your app.",
  },
  {
    t: 'An iOS UX audit',
    length: 'One week',
    d: 'For an app that works but does not feel right. A written report of what to fix, in order of impact, each point with a screenshot and the change that fixes it. The report is yours to keep, whoever does the work.',
  },
];
const offerItems = offers.map((o) => ({
  t: o.t,
  meta: `${o.length}. ${o.price ?? 'Fixed price, agreed before work starts'}.`,
  d: o.d,
}));

// What people who have worked with the founder say, in their words. Each entry needs their
// permission and their real name; `href` is their LinkedIn or site. The section appears on
// the page once there is at least one entry.
const testimonials: { quote: string; name: string; role: string; href?: string }[] = [];

// What a client can hold the studio to. Each line is a commitment the founder has agreed to.
const promises = [
  { t: 'You own everything', d: 'The code, the design files and the App Store listing are yours from day one. The repository lives in your account, so you are never locked in.' },
  { t: 'NDA before the idea', d: 'Happy to sign an NDA before you share anything.' },
  { t: 'Pay in milestones', d: 'The project is split into milestones and paid as each one is delivered. Never the whole amount upfront.' },
  { t: 'A build every week', d: 'A TestFlight build on your phone and a short written update every week of the build, so you always know where things stand.' },
  { t: '30-day bug warranty', d: 'Any bug found in the 30 days after launch is fixed free.' },
];

const services = [
  { t: 'Live Activities, Dynamic Island and widgets', d: 'The lock screen and Dynamic Island for an app you already have, updated by push from your server, and home screen widgets beside them.' },
  { t: 'iPhone apps, end to end', d: 'From the first sketch to the App Store: product thinking, interface design, Swift engineering and launch.' },
  { t: 'Redesigns and UX audits', d: 'For iOS apps that work but do not feel right. A clear list of what to fix, then the fixes.' },
  { t: 'Design systems', d: 'Components, type and colour for your iOS interface, built from scratch or cleaned up, so the app stays consistent as it grows.' },
  { t: 'App Store launch', d: 'The listing, the screenshots, TestFlight builds and the review submission.' },
  { t: 'Updates and upkeep', d: 'New versions after launch, kept current with each iOS release and monitored for crashes.' },
];

const process = [
  { t: 'Discover', d: 'A call about the idea, then a written estimate and plan, split into milestones.' },
  { t: 'Design', d: 'Screens, flows and motion in Figma, agreed with you before any code is written.' },
  { t: 'Build', d: 'The app in Swift and SwiftUI, with a new TestFlight build on your phone and a written update every week.' },
  { t: 'Launch and run', d: 'App Store submission, a 30-day bug warranty, then updates and monitoring if you want them.' },
];

const first = site.founder.name.split(' ')[0];
// The first eight questions are Frame Sixty's iOS FAQ (framesixty.com/ios-app-development-company),
// taken word for word at the founder's request, with the company name changed. The few
// departures are where their answer would not be true here: the cross-platform answer ends
// before "We build both"; the submission answer leaves out "hundreds of apps"; the launch
// answer opens with this studio's own warranty in place of "Most clients keep us on"; the
// takeover answer drops React Native and Flutter; TestFlight builds are weekly and the code
// is the client's from the first day, as the promises above say. The last four are ours.
const faq = [
  { t: 'How much does iOS app development cost?', d: 'The cost of an iOS app depends on scope: a single-flow MVP is a different budget from a multi-role product with backend integrations and a release cadence. Project work is quoted as a fixed bid after a discovery call, so the full cost is clear before development begins. A 30-minute call produces an accurate range for your idea.' },
  { t: 'How long does iOS app development take from kickoff to the App Store?', d: 'A focused iOS app typically takes three to four months from kickoff to App Store; larger products with backends and multiple user roles run six months or more. Design and engineering overlap rather than running end to end, and we ship a working TestFlight build every week so progress stays visible.' },
  { t: 'Should I build a native Swift app or go cross-platform?', d: 'Build native Swift when performance, platform features or long-term maintainability matter — camera work, ARKit, HealthKit, widgets and background processing all behave better natively. Cross-platform earns its place when the same straightforward app has to ship on iOS and Android at once.' },
  { t: 'Can one codebase cover both iPhone and iPad?', d: 'Yes — a SwiftUI codebase targets iPhone and iPad together. We design the iPad layout deliberately rather than stretching the phone screen: split views, keyboard and trackpad support, and Apple Pencil where it fits. That costs a fraction of building a second app while still giving iPad users an interface built for the larger canvas.' },
  { t: 'Do you handle App Store submission and review?', d: 'Yes — App Store Connect setup, provisioning, privacy nutrition labels, screenshots and the review process are part of every build we deliver.' },
  { t: 'What happens after my iOS app launches?', d: 'Bugs found in the first 30 days are fixed free. Apple deprecates APIs as it ships, so an app with no maintenance plan degrades on a predictable schedule. Support is scoped monthly or per release, whichever suits you.' },
  { t: 'Can you take over an existing iOS app?', d: 'Yes. We start with a code and architecture review, then give you an honest read: what is salvageable, what needs rewriting, and what each path costs. We take over Swift and Objective-C codebases.' },
  { t: `Will I own my iOS app's source code, and does ${site.name} sign an NDA?`, d: `Yes — ${site.name} signs NDAs before you share anything sensitive, and you own the app and its full Swift source code from the first day. The source ships with documentation any future iOS developer can pick up, so you are never locked into working with us.` },
  { t: 'Who will I work with?', d: `${first}, who designs and builds the app. There is no account manager relaying messages, so questions are answered by the person who can change the code.` },
  { t: 'What if you become unavailable?', d: 'The code lives in your own repository from the first day, written in standard Swift and SwiftUI, so any iOS developer can pick it up. You are never locked in.' },
  { t: 'Do you work with clients outside India?', d: `Yes. The work is remote by default: a call to start, then a TestFlight build on your phone and a written update every week. The studio is on ${site.timezone}, and calls are arranged to overlap with your working day.` },
  { t: 'Do you build for Android too?', d: "No. Client work is native iOS only: Swift for iPhone, with iPad and Mac when the app calls for them. (The studio's own BubbleNest has an Android version too.)" },
];

// The email opens with the four things needed to reply usefully, so nobody faces a blank page.
const brief = [`Hi ${first},`, '', 'What the app should do:', 'Where it is now (idea, designs or an existing app):', 'When you need it:', 'Budget range (optional):', ''].join('\n');
const projectMail = `mailto:${site.email}?subject=${encodeURIComponent('New iOS project')}&body=${encodeURIComponent(brief)}`;
const chat = whatsapp();
// The brief form builds its own message, so it needs the bare WhatsApp link to append to.
const chatBase = whatsapp('');

// The page follows the questions a buyer asks, in the order they ask them: can this person
// do it (track record), show me (work), who is it (founder), how do I start (offers,
// services), how will it run (process, promises), with what (stack), what about... (FAQ).
// Sections alternate between paper and the soft band. The order is listed once, with the
// optional sections left out when they are empty, so the bands never double up. The stack
// is a dark card on paper and sits between two bands of its own accord.
const order = [
  HOME_IDS.track,
  HOME_IDS.apps,
  ...(testimonials.length > 0 ? [HOME_IDS.testimonials] : []),
  HOME_IDS.founder,
  HOME_IDS.offers,
  HOME_IDS.services,
  HOME_IDS.process,
  HOME_IDS.promises,
  HOME_IDS.faq,
  ...(posts.length > 0 ? [HOME_IDS.writing] : []),
  HOME_IDS.contact,
];
const band = (id: string) => `section${order.indexOf(id) % 2 === 1 ? ' section--soft' : ''}`;
---

<Base title={`${site.name}: iOS app development studio in Bengaluru`} jsonLd={[organization(), person(await portraitUrl()), website(), faqPage(faq)]}>
  <section class="hero">
    <div class="container">
      <p class="kicker hero__kicker">{site.name} is an iOS app studio in Bengaluru.</p>
      {/* The heading breaks between phrases: "iPhone app" and "App Store" each stay on one line. */}
      <h1 class="display">{site.tagline.replace('iPhone app', 'iPhone\u00a0app').replace('App Store', 'App\u00a0Store')}</h1>
      <p class="lead hero__lead">
        For founders and product teams who want a native iOS app done well. You work directly with
        {site.founder.name}, the iOS engineer behind Blinkit's order-tracking Live Activity, from the first sketch to
        launch.
      </p>
      <div class="hero__actions">
        <a href={`#${HOME_IDS.contact}`} class="btn" data-e="hero-start">Start a project</a>
        <a href={chat} class="btn btn--ghost" target="_blank" rel="noopener" data-e="hero-whatsapp">Message on WhatsApp</a>
      </div>
      <p class="hero__creds">{credentials}</p>
      <Strip shots={heroShots} variant="hero" eager={4} />
    </div>
  </section>

  <section class={band(HOME_IDS.track)} id={HOME_IDS.track}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">Track record</h2>
        <p class="kicker">{cap(num(track.length))} things worth checking before you hire an iOS developer.</p>
      </div>
      <Defs items={track} />
    </div>
  </section>

  <section class={band(HOME_IDS.apps)} id={HOME_IDS.apps}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">Work</h2>
        <p class="kicker">The studio's own apps, live on the App Store. Screenshots are from the store listings.</p>
      </div>
      <div class="rows">
        {apps.map((app) => <AppRow app={app} />)}
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class={band(HOME_IDS.testimonials)} id={HOME_IDS.testimonials}>
      <div class="container">
        <div class="section__head">
          <h2 class="display">In their words</h2>
          <p class="kicker">From people who have worked with {first}.</p>
        </div>
        <div class="quotes">
          {testimonials.map((q) => (
            <figure class="quote">
              <blockquote>{q.quote}</blockquote>
              <figcaption>
                {q.href ? <a class="link" href={q.href} target="_blank" rel="noopener">{q.name}</a> : q.name}, {q.role}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class={band(HOME_IDS.founder)} id={HOME_IDS.founder}>
    <div class="container">
      <Founder>
        <p>
          You work directly with the person building your app, with no account managers in between. Krithick is
          an iOS engineer who worked on {workHistory} before starting {site.name}. Every app on this page is his
          work, from the first sketch to the store listing.
        </p>
        <p><a class="link" href="/about/">More about Krithick and how the studio works</a></p>
      </Founder>
    </div>
  </section>

  <section class={band(HOME_IDS.offers)} id={HOME_IDS.offers}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">Start small</h2>
        <p class="kicker">Two fixed-scope projects for an app you already have.</p>
      </div>
      <Defs items={offerItems} />
      <p class="section__after">
        Starting from an idea instead? <a class="link" href={`#${HOME_IDS.process}`}>See how a full build works</a>.
      </p>
    </div>
  </section>

  <section class={band(HOME_IDS.services)} id={HOME_IDS.services}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">Services</h2>
        <p class="kicker">What you can hire {site.name} for.</p>
      </div>
      <Defs items={services} />
    </div>
  </section>

  <section class={band(HOME_IDS.process)} id={HOME_IDS.process}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">How it works</h2>
        <p class="kicker">From the first call to the App Store.</p>
      </div>
      <p class="lead">
        Every stage has a decision in it. You get the options and the trade-offs in plain language, so you can
        decide with confidence.
      </p>
      <Defs items={process} numbered />
    </div>
  </section>

  <section class={band(HOME_IDS.promises)} id={HOME_IDS.promises}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">What you can count on</h2>
        <p class="kicker">In writing, on every project.</p>
      </div>
      <Defs items={promises} />
    </div>
  </section>

  <section class="section section--stack" id={HOME_IDS.stack}>
    <Stack
      title="Our iOS development stack"
      lead="The full Apple toolchain: Swift 6, SwiftUI, Xcode, TestFlight and App Store Connect, with ARKit, RealityKit and Unity when an app needs augmented reality or 3D."
    />
  </section>

  <section class={band(HOME_IDS.faq)} id={HOME_IDS.faq}>
    <div class="container">
      <div class="section__head section__head--center">
        <h2 class="display">iOS app development FAQs</h2>
        <p class="lead">
          Common questions about building an iOS app with {site.name} — what it costs, how long it takes, how native
          Swift compares to cross-platform, and what happens after launch.
        </p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  {posts.length > 0 && (
    <section class={band(HOME_IDS.writing)} id={HOME_IDS.writing}>
      <div class="container">
        <div class="section__head">
          <h2 class="display">Writing</h2>
          <p class="kicker">Build notes: what shipped, what broke, what it took.</p>
        </div>
        <div class="posts">
          {posts.map((p) => <PostItem post={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class={band(HOME_IDS.contact)} id={HOME_IDS.contact}>
    <div class="container">
      <div class="section__head">
        <h2 class="display">Start a project</h2>
        <p class="kicker">Replies within 24 to 48 hours.</p>
      </div>
      <p class="lead">
        Tell {first} what the app should do, where it is now (an idea, designs or an existing app), when you need it
        and, if you have one, a budget range.
      </p>

      {/* Hidden until the script below runs: without it the direct links underneath are the way in. */}
      <form class="brief" id="brief" hidden novalidate data-first={first} data-email={site.email} data-wa={chatBase}>
        <label class="brief__field brief__field--wide">
          <span>What should the app do?</span>
          <textarea name="what" rows="4" required></textarea>
        </label>
        <label class="brief__field">
          <span>Where is it now?</span>
          <select name="stage">
            <option>An idea</option>
            <option>Designs</option>
            <option>An existing app</option>
          </select>
        </label>
        <label class="brief__field">
          <span>When do you need it?</span>
          <input name="when" type="text" autocomplete="off" />
        </label>
        <label class="brief__field">
          <span>Budget range, if you have one</span>
          <input name="budget" type="text" autocomplete="off" />
        </label>
        <label class="brief__field">
          <span>Your name</span>
          <input name="name" type="text" autocomplete="name" />
        </label>
        <div class="brief__actions">
          <button type="button" class="btn" data-send="whatsapp">Send on WhatsApp</button>
          <button type="button" class="btn btn--ghost" data-send="email">Send by email</button>
          <button type="button" class="btn btn--ghost" data-send="copy">Copy the brief</button>
        </div>
        <p class="brief__status small" role="status" aria-live="polite"></p>
      </form>

      <div class="contact">
        <div>
          <p class="contact__label">Email</p>
          <a class="contact__big link" href={projectMail} data-e="contact-email">{site.email}</a>
        </div>
        <div>
          <p class="contact__label">WhatsApp or call</p>
          <a class="contact__big link" href={chat} target="_blank" rel="noopener" data-e="contact-whatsapp">{phoneDisplay}</a>
        </div>
      </div>
      <p class="contact__note small">
        {site.basedIn}, India, on {site.timezone}. Calls are arranged to overlap with your working day.
        {site.bookingUrl && (
          <>
            {' '}
            <a class="link" href={site.bookingUrl} target="_blank" rel="noopener" data-e="contact-book">Book a call</a>.
          </>
        )}
      </p>
      <div class="contact__socials">
        <p class="contact__label">{first} elsewhere</p>
        <Socials />
      </div>
    </div>
  </section>

  <script is:inline>
    // The brief form. It has no server behind it: it writes the answers into one message and
    // hands that to WhatsApp, the visitor's mail app or the clipboard.
    (function () {
      var form = document.getElementById('brief');
      if (!form) return;
      form.hidden = false;
      var status = form.querySelector('.brief__status');
      var email = form.dataset.email;
      var val = function (name) { return (form.elements[name].value || '').trim(); };
      var message = function () {
        var lines = ['Hi ' + form.dataset.first + ',', '', 'What the app should do: ' + val('what'), 'Where it is now: ' + val('stage')];
        if (val('when')) lines.push('When I need it: ' + val('when'));
        if (val('budget')) lines.push('Budget range: ' + val('budget'));
        if (val('name')) lines.push('', val('name'));
        return lines.join('\n');
      };
      form.addEventListener('submit', function (e) { e.preventDefault(); });
      form.addEventListener('input', function () { form.elements.what.removeAttribute('aria-invalid'); });
      form.addEventListener('click', function (e) {
        var button = e.target.closest('[data-send]');
        if (!button) return;
        if (!val('what')) {
          form.elements.what.setAttribute('aria-invalid', 'true');
          form.elements.what.focus();
          status.textContent = 'Add a line about what the app should do first.';
          return;
        }
        var kind = button.getAttribute('data-send');
        var body = message();
        if (window.countClick) window.countClick('brief-' + kind);
        if (kind === 'whatsapp') {
          window.open(form.dataset.wa + encodeURIComponent(body), '_blank', 'noopener');
          status.textContent = 'WhatsApp is opening with your brief typed in. Press send there.';
        } else if (kind === 'email') {
          location.href = 'mailto:' + email + '?subject=' + encodeURIComponent('New iOS project') + '&body=' + encodeURIComponent(body);
          status.textContent = 'Your mail app should open with the brief. If nothing opens, copy the brief and send it to ' + email + '.';
        } else {
          var copied = function () { status.textContent = 'Copied. Paste it into a message to ' + email + '.'; };
          var failed = function () { status.textContent = 'Copying is blocked in this browser. Write to ' + email + ' instead.'; };
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(body).then(copied, failed);
          else failed();
        }
      });
    })();
  </script>
</Base>
