---
import Base from './Base.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  updated?: string;
  description?: string;
  eyebrow?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  updated = 'June 2026',
  description,
  eyebrow = `${site.name} legal`,
  backHref = '/',
  backLabel = `Back to ${site.name}`,
} = Astro.props;
---

<Base title={`${title} | ${site.name}`} description={description}>
  <section class="legal">
    <div class="container">
      <p class="kicker hero__kicker">{eyebrow}</p>
      <h1 class="display">{title}</h1>
      <p class="legal__updated">Last updated {updated}</p>
      <div class="prose">
        <slot />
      </div>
      <a class="legal__back link link--quiet" href={backHref}>{backLabel}</a>
    </div>
  </section>
</Base>
