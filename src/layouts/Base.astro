---
import '../styles/global.css';
import { site, absolute } from '../lib/site';
// Preload the two faces the first paint needs. The hashed URLs come from the same
// package the stylesheet imports, so they can never drift apart.
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import serifRegular from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Path of the OG image, e.g. /og/reelmark.png. Every page has one. */
  ogImage?: string;
  /** 'article' for build notes, 'website' for everything else. */
  ogType?: 'website' | 'article';
  /** ISO date of an article, emitted as article:published_time. */
  published?: string;
  /** JSON-LD object(s) to embed, already shaped. */
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title = `${site.name}: ${site.tagline}`,
  description = site.description,
  ogImage = '/og/home.png',
  ogType = 'website',
  published,
  jsonLd,
  noindex = false,
} = Astro.props;

// Canonical URLs carry a trailing slash, matching the sitemap and the /about/index.html
// layout Caddy serves. The root is just "/".
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = absolute(path === '/' ? '/' : `${path}/`);
const ogImageUrl = absolute(ogImage);

const navLinks = [
  { href: '/#apps', label: 'Apps' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];

const footerLinks = [
  { href: '/about/', label: 'About' },
  { href: '/writing/', label: 'Writing' },
  { href: '/legal/terms/', label: 'Terms' },
  { href: '/legal/privacy/', label: 'Privacy' },
  { href: '/legal/refunds/', label: 'Refunds' },
  { href: '/legal/shipping/', label: 'Delivery' },
  { href: '/legal/pricing/', label: 'Pricing' },
  { href: '/legal/contact/', label: 'Contact' },
];

const isCurrent = (href: string) => href.replace(/\/$/, '') === path;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// "<" is escaped so no content string can close the script element early.
const ldJson = (obj: object) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.founder.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifRegular} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fbfbf9" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {published && <meta property="article:author" content={absolute('/about/')} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ld.map((obj) => <script type="application/ld+json" set:html={ldJson(obj)} />)}
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="container nav__inner">
        <a href="/" class="nav__logo">{site.name}</a>
        <nav class="nav__links" aria-label="Main">
          {navLinks.map((l) => (
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <div>
          <nav class="footer__links" aria-label="Footer">
            {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          </nav>
          <p class="footer__meta">
            &copy; 2026 <strong>{site.name}</strong>. Owned and operated by {site.founder.name}.<br />
            {site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}, India
          </p>
        </div>
        <a class="link link--quiet" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>

    <script is:inline>
      // The only script on the site: a hairline under the nav once the page has scrolled.
      (function () {
        var nav = document.getElementById('nav');
        if (!nav) return;
        var on = function () { nav.classList.toggle('is-scrolled', window.scrollY > 8); };
        window.addEventListener('scroll', on, { passive: true });
        on();
      })();
    </script>
  </body>
</html>
